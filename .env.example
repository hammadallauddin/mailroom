# Copy to .env and fill in real values.
# Get a Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# Optional: switch model/provider (any LangChain model id works)
# MAILROOM_MODEL=google_genai:gemini-2.5-flash
# MAILROOM_EVAL_MODEL=openai:gpt-4o
# MAILROOM_TEMPERATURE=0

# Who the assistant works for (used in prompts)
# MAILROOM_BACKGROUND="I'm a software engineer who wants help staying on top of a busy inbox."

# LangSmith tracing + evaluation
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=mailroom

# Gmail ingestion (only needed for the Gmail graph)
# EMAIL_ADDRESS=you@example.com
